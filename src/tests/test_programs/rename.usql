DOMAIN ModCode IS String;
DOMAIN MTitle IS String;
DOMAIN MSem IS Int;
DOMAIN MCredit IS Int;

TYPE mc AS ModCode;
TYPE mt AS MTitle;
TYPE ms AS MSem;
TYPE cr AS MCredit;

TYPE mc1 AS ModCode;
TYPE mt1 AS MTitle;
TYPE ms1 AS MSem;
TYPE cr1 AS MCredit;

RELATION module WITH mc, mt, ms, cr;

LOAD "./tests/test_files/module.csv" INTO module;

RENAME module ON mc1, mt1, ms1, cr1;
