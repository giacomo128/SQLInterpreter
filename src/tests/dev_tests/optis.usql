DOMAIN ModCode IS String;
DOMAIN MTitle IS String;
DOMAIN MSem IS Int;
DOMAIN MCredit IS Int;

TYPE mc AS ModCode;
TYPE mt AS MTitle;
TYPE ms AS MSem;
TYPE cr AS MCredit;

TYPE mc1 AS ModCode;
TYPE mt1 AS MTitle;
TYPE ms1 AS MSem;
TYPE cr1 AS MCredit;

RELATION module WITH mc, mt, ms, cr;
RELATION module1 WITH mc1, mt1, ms1, cr1;

LOAD "./module.csv" INTO module;
LOAD "./module1.csv" INTO module1;

LET b1 BE JOIN module AND module1;
PROJECT b1 ON mt, cr;

